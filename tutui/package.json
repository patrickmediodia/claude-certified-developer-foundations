{
  "name": "tutui",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive terminal study coach for the Claude Certified Developer - Foundations exam",
  "type": "module",
  "bin": {
    "tutui": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "parse": "tsx scripts/parse-report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "chalk": "6.0.1",
    "cli-table3": "0.6.5",
    "ink": "8.0.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "marked": "15.0.12",
    "marked-terminal": "7.3.0",
    "react": "19.3.1",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/marked-terminal": "6.1.1",
    "@types/node": "24.12.0",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "files": [
    "dist"
  ]
}
